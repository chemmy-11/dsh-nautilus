{
  "name": "@dsh-external/dsh-nexus",
  "version": "0.0.1",
  "description": "Vault 观测插件：Obsidian vault 元数据快照 + 编辑统计 + 观测面板（可配置任意 vault）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.2",
    "@types/node": "^24.13.3",
    "cordis": ">=4.0.0-rc <5",
    "esbuild": "^0.28.2",
    "schemastery": "^3.18.0",
    "typescript": "~5.9.0"
  },
  "scripts": {
    "build": "node scripts/prepare.mjs",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test scripts/test.mjs",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "allowScripts": {
    "file:../esbuild@0.28.1/node_modules/esbuild": true,
    "file:../../esbuild@0.25.12/node_modules/esbuild": true,
    "file:../../esbuild@0.28.1/node_modules/esbuild": true,
    "file:../../esbuild@0.21.5/node_modules/esbuild": true
  }
}
